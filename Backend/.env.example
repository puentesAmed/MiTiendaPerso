# Required in production
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/mitiendaperso
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Persistent local storage. In production STORAGE_ROOT must be a mounted volume.
# Render staging: mount the Persistent Disk at /var/data and use /var/data/uploads.
STORAGE_PROVIDER=local
STORAGE_ROOT=./uploads

# Designer V2 mockups: disabled unless the local Python engine is configured.
MOCKUP_ENGINE_ENABLED=false
MOCKUP_ENGINE_PYTHON=python
MOCKUP_ENGINE_ROOT=../../automated_mockups
MOCKUP_ENGINE_TIMEOUT_MS=15000

# Optional SMTP: leave every value empty to disable email delivery.
# If any value is set, the complete block is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_EMAIL=

# Transactional email via Resend (backend only). Verify sender domain before enabling.
TRANSACTIONAL_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=MiLuGui
RESEND_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=
PUBLIC_STOREFRONT_URL=

# Dormant integrations: keep disabled unless a separate approved release enables them.
ALIEXPRESS_CATALOG_ENABLED=false
MONGO_URI_ALIEXPRESS=
DROPSHIPPING_ENABLED=false
DROPSHIPPING_API_URL=
MONEI_ENABLED=false
MONEI_API_KEY=
MONEI_WEBHOOK_SECRET=

# Manual payments: configuration is required only when its flag is true.
MANUAL_PAYMENT_BIZUM_ENABLED=false
MANUAL_PAYMENT_BIZUM_RECIPIENT=
MANUAL_PAYMENT_BIZUM_INSTRUCTIONS=

MANUAL_PAYMENT_BANK_TRANSFER_ENABLED=false
MANUAL_PAYMENT_BANK_ACCOUNT_HOLDER=
MANUAL_PAYMENT_BANK_IBAN=
MANUAL_PAYMENT_BANK_INSTRUCTIONS=

# Optional distance-based shipping. If disabled, the existing zone rules apply.
SHIPPING_DISTANCE_ENABLED=false
SHIPPING_ORIGIN_LAT=
SHIPPING_ORIGIN_LON=
SHIPPING_DISTANCE_BANDS_JSON=[]
SHIPPING_DISTANCE_CACHE_TTL_MS=3600000
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
